{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit UI",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "CLI (current file as input)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_cli.py",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
